# Required: bot token from the Discord Developer Portal
DISCORD_TOKEN=

# Optional: default Groq model (per-server override with /setmodel)
GROQ_MODEL=qwen/qwen3.8-27b

# Optional: summarize when strictly more than this many messages have
# arrived since the previous summary (spec default: 10)
MESSAGE_THRESHOLD=10

# Optional: how often to check channels, in seconds (spec default: 60)
INTERVAL_SECONDS=60

# Optional: sync slash commands instantly to one guild for testing
DEV_GUILD_ID=

# Optional: where the SQLite database lives
DB_PATH=data/chatsummarizer.db
